[sub_resource type="GDScript" id="GDScript_3pphf"]
script/source = "extends CharacterBody2D
@onready var sprite_2d: AnimatedSprite2D = $Sprite2D
@onready var timer: Timer = $Timer
@onready var atom: Area2D = $\"../atom\"
@onready var label: Label = $\"../Label\"
@onready var atom2: Area2D = $\"../atom2\"
@onready var atom3: Area2D = $\"../atom3\"
@onready var label_2: Label = $\"../Label2\"
@onready var player: CharacterBody2D = $\".\"

var SPEED = 100.0
var JUMP_VELOCITY = -400.0
var scale_speed = 0.1
var newscale = Vector2(0,0)
var isinarea = false
var alive = true 

func _ready() -> void:
	label.visible = false
	label_2.visible = false

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction:
		velocity.x = direction * SPEED
		sprite_2d.play(\"walk\")
		sprite_2d.flip_h = direction < 0 
			
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
		sprite_2d.play('default')
	
	move_and_slide()
	
func _process(delta: float) -> void:
	var newx = sprite_2d.global_scale.x - scale_speed/100
	sprite_2d.global_scale.x = newx
	var newy = sprite_2d.global_scale.y - scale_speed/100
	sprite_2d.global_scale.y = newy
	sprite_2d.global_scale = Vector2(newx, newy)
	if alive == false:
		restart()
		
	

func _on_timer_timeout() -> void:
	scale_speed = 0 
	SPEED = 0
	JUMP_VELOCITY = 0
	self.visible = false 
	label.position = self.position + Vector2(-20, -40)
	label.visible = true 
	alive = false 

func _on_atom_body_entered(body: Node2D) -> void:
	if body == self:
		isinarea = true 

func _on_atom_body_exited(body: Node2D) -> void:
	if body == self:
		isinarea = false 
		
func _input(event: InputEvent) -> void:
	if isinarea == true and Input.is_action_just_pressed(\"pick_up\"):
		timer.start()
		sprite_2d.global_scale = Vector2(1,1) 
		atom.visible = false
		
func _on_atom_2_body_entered(body: Node2D) -> void:
	if body == self:
		isinarea = true 

func _on_atom_2_body_exited(body: Node2D) -> void:
	if body == self:
		isinarea = false 
		
func _on_atom_3_body_entered(body: Node2D) -> void:
	if body == self:
		isinarea = true 

func _on_atom_3_body_exited(body: Node2D) -> void:
	if body == self:
		isinarea = false 
		
func _on_atom_4_body_entered(body: Node2D) -> void:
	if body == self:
		isinarea = true 

func _on_atom_4_body_exited(body: Node2D) -> void:
	if body == self:
		isinarea = false 
func _on_atom_5_body_entered(body: Node2D) -> void:
	if body == self:
		isinarea = true 
		scale_speed = 0
		SPEED = 0
		label_2.visible=true
		JUMP_VELOCITY = 0
	
func _on_atom_5_body_exited(body: Node2D) -> void:
	if body == self:
		isinarea = false 
		
func restart():
	if Input.is_action_just_pressed(\"restart\"):
		player.global_position = Vector2(12,15)
		sprite_2d.global_scale = Vector2(1,1)
		scale_speed = 0.1
		self.visible = true
		SPEED = 100
		JUMP_VELOCITY = -400
		label.visible = false
"

